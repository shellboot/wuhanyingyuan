# Copy this file to .env and replace every placeholder before deployment.
SITE_URL=https://www.wuhanyingyuan.com
DOMAIN=www.wuhanyingyuan.com
CERTBOT_EMAIL=ops@example.com

DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=replace-with-a-long-random-password
DB_ROOT_PASSWORD=replace-with-another-long-random-password

ADMIN_USER=siteadmin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_EMAIL=admin@example.com

EDITOR_USER=editor
EDITOR_PASSWORD=
EDITOR_EMAIL=editor@example.com

PUBLISHER_USER=publisher
PUBLISHER_EMAIL=publisher@example.com
PUBLISHER_APP_NAME=新闻发布工具
NEWS_CATEGORY_SLUG=industry-news

BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

WP_ENVIRONMENT_TYPE=production
WP_DEBUG=false
