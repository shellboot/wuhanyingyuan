limit_req_zone $binary_remote_addr zone=wp_login:10m rate=10r/m;

server {
    listen 80;
    server_name ${DOMAIN} ${MEITUAN_DOMAIN};

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    root /var/www/html;
    index index.php;
    server_tokens off;
    client_max_body_size 64m;

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/snippets/security-headers.conf;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }

    location = /wp-login.php {
        limit_req zone=wp_login burst=5 nodelay;
        include /etc/nginx/snippets/php-fpm.conf;
    }

    location = /xmlrpc.php {
        deny all;
    }

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~* /wp-content/.*\.php$ {
        deny all;
    }

    location ~ \.php$ {
        include /etc/nginx/snippets/php-fpm.conf;
    }

    location ~* \.(?:css|js|jpg|jpeg|png|gif|webp|avif|svg|ico|woff2?)$ {
        try_files $uri =404;
        expires 7d;
        access_log off;
    }

    location = /wp-config.php {
        deny all;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${MEITUAN_DOMAIN};

    server_tokens off;
    client_max_body_size 1m;

    ssl_certificate /etc/letsencrypt/live/${MEITUAN_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${MEITUAN_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/snippets/security-headers.conf;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        proxy_pass http://meituan:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
    }
}
